PORT=8080
APP_ENV=development
SEED_DEMO_DATA=false
DATABASE_URL=postgres://orbit:orbit@127.0.0.1:5434/orbit_chat?sslmode=disable
FRONTEND_ORIGIN=http://127.0.0.1:4174
COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Provider switching. Leave AI_PROVIDER empty to keep the legacy OPENAI_* settings.
# Supported: openai, gemini, ollama, openrouter, bedrock, mock
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_REGION=ap-northeast-1
AI_DAILY_REQUEST_LIMIT=100
TRUST_PROXY_HEADERS=false
# When TRUST_PROXY_HEADERS=true, set the direct proxy network and the number
# of trusted proxy hops. Forwarded addresses are selected from right to left.
TRUSTED_PROXY_CIDRS=
TRUSTED_PROXY_HOPS=1
# Provider-specific aliases are also accepted:
# GEMINI_API_KEY= / OPENROUTER_API_KEY= / BEDROCK_API_KEY= / OLLAMA_MODEL=
