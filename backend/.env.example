PORT=8080
APP_ENV=development
SEED_DEMO_DATA=false
DATABASE_URL=postgres://orbit:orbit@127.0.0.1:5434/orbit_chat?sslmode=disable
FRONTEND_ORIGIN=http://127.0.0.1:4174
COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# プロバイダーを切り替えます。AI_PROVIDERを空にすると、従来のOPENAI_*設定を使います。
# 対応プロバイダー: openai、gemini、ollama、openrouter、bedrock、mock
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_REGION=ap-northeast-1
AI_DAILY_REQUEST_LIMIT=100
TRUST_PROXY_HEADERS=false
# TRUST_PROXY_HEADERS=trueの場合は、直接接続するプロキシのネットワークと信頼する段数を設定します。
# 転送されたアドレスは右から左へ選択します。
TRUSTED_PROXY_CIDRS=
TRUSTED_PROXY_HOPS=1
# プロバイダー固有の別名も利用できます:
# GEMINI_API_KEY= / OPENROUTER_API_KEY= / BEDROCK_API_KEY= / OLLAMA_MODEL=
